 	file_time.dwHighDateTime = driver_version[driver_type].dwFileDateMS;
 	file_time.dwLowDateTime = driver_version[driver_type].dwFileDateLS;
 	if ( ((file_time.dwHighDateTime == 0) && (file_time.dwLowDateTime == 0))
