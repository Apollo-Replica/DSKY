diff --git a/config.h b/config.h
new file mode 100644
index 0000000..67fe47a
--- /dev/null
+++ b/config.h
@@ -0,0 +1,6 @@
+/* Hand-written config for the DSKY Flasher build: x64 only, WinUSB from the
+   OS (Windows 8+), so no WDK coinstallers and no libusb0/libusbK files. */
+#define OPT_M64 1
+#define WDF_VER 1011
+#define ENABLE_LOGGING 1
+#define _GNU_SOURCE 1
